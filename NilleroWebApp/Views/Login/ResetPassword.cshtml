@* ============================================================
   ResetPassword.cshtml
   ============================================================ *@
@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Set new password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="nl-auth-card">

    <div class="nl-auth-card__header">
        <h1 class="nl-auth-card__title">Set a new password</h1>
        <p class="nl-auth-card__subtitle">Choose a strong password you haven't used before.</p>
    </div>

    @if (ViewBag.hasError == true && ViewBag.Errors != null)
    {
        <div class="nl-auth-error-list" role="alert">
            <div class="nl-auth-error-list__title">
                <i class="ph-fill ph-warning-circle" aria-hidden="true"></i>
                <span>Please fix the following:</span>
            </div>
            <ul>
                @foreach (var error in (IEnumerable<string>)ViewBag.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <form asp-controller="Login"
          asp-action="ResetPassword"
          method="post"
          novalidate>

        @Html.AntiForgeryToken()

        @* Hidden fields carrying the reset token *@
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />

        <div class="nl-field">
            <label asp-for="Password" class="nl-label">New password</label>
            <div class="nl-input-group">
                <input asp-for="Password"
                       class="nl-input @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "is-invalid" : "")"
                       type="password"
                       autocomplete="new-password"
                       placeholder="At least 8 characters"
                       id="reset-password"
                       autofocus />
                <button type="button"
                        class="nl-input-group__toggle"
                        aria-label="Toggle password visibility"
                        data-target="reset-password">
                    <i class="ph ph-eye" id="reset-password-icon" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="nl-field-error"></span>
        </div>

        <div class="nl-field">
            <label asp-for="ConfirmPassword" class="nl-label">Confirm new password</label>
            <div class="nl-input-group">
                <input asp-for="ConfirmPassword"
                       class="nl-input @(ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? "is-invalid" : "")"
                       type="password"
                       autocomplete="new-password"
                       placeholder="••••••••"
                       id="reset-confirm-password" />
                <button type="button"
                        class="nl-input-group__toggle"
                        aria-label="Toggle confirm password visibility"
                        data-target="reset-confirm-password">
                    <i class="ph ph-eye" id="reset-confirm-password-icon" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="nl-field-error"></span>
        </div>

        <div style="margin-top: 24px;">
            <button type="submit" class="nl-btn nl-btn--primary nl-btn--lg" style="width:100%;">
                Update password
            </button>
        </div>

    </form>

    <div class="nl-auth-footer">
        <p class="nl-auth-footer__text">
            <a asp-controller="Login" asp-action="Index" class="nl-auth-link">Back to sign in</a>
        </p>
    </div>

</div>

@section Head {
    <link rel="stylesheet" href="~/css/nillero-auth.css" asp-append-version="true" />
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.querySelectorAll('[data-target]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(this.dataset.target);
                var icon  = document.getElementById(this.dataset.target + '-icon');
                var isHidden = input.type === 'password';
                input.type = isHidden ? 'text' : 'password';
                icon.className = isHidden ? 'ph ph-eye-slash' : 'ph ph-eye';
                btn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
            });
        });
    </script>
}
