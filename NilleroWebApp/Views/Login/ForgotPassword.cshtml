@* ============================================================
   ForgotPassword.cshtml
   ============================================================ *@
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="nl-auth-card">

    <div class="nl-auth-card__header">
        <h1 class="nl-auth-card__title">Reset your password</h1>
        <p class="nl-auth-card__subtitle">
            Enter your username and we'll send you a link to reset your password.
        </p>
    </div>

    @if (ViewBag.hasError == true && ViewBag.Errors != null)
    {
        <div class="nl-auth-error-list" role="alert">
            <div class="nl-auth-error-list__title">
                <i class="ph-fill ph-warning-circle" aria-hidden="true"></i>
                <span>Please fix the following:</span>
            </div>
            <ul>
                @foreach (var error in (IEnumerable<string>)ViewBag.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <form asp-controller="Login"
          asp-action="ForgotPassword"
          method="post"
          novalidate>

        @Html.AntiForgeryToken()

        <div class="nl-field">
            <label asp-for="UserName" class="nl-label">Username</label>
            <input asp-for="UserName"
                   class="nl-input @(ViewData.ModelState["UserName"]?.Errors.Count > 0 ? "is-invalid" : "")"
                   type="text"
                   autocomplete="username"
                   placeholder="your_username"
                   autofocus />
            <span asp-validation-for="UserName" class="nl-field-error"></span>
        </div>

        <div style="margin-top: 24px;">
            <button type="submit" class="nl-btn nl-btn--primary nl-btn--lg" style="width:100%;">
                Send reset link
            </button>
        </div>

    </form>

    <div class="nl-auth-footer">
        <p class="nl-auth-footer__text">
            Remembered it?
            <a asp-controller="Login" asp-action="Index" class="nl-auth-link">Back to sign in</a>
        </p>
    </div>

</div>

@section Head {
    <link rel="stylesheet" href="~/css/nillero-auth.css" asp-append-version="true" />
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
